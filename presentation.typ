// СЛАЙД 9. XVI ВЕК: СУДЕБНИК 1550 Г. И ОТМЕНА КОРМЛЕНИЙ
// -----------------------------------------------------------------------------
#slide-title("Судебник 1550 г. и ликвидация кормлений", subtitle: "Введение уголовных наказаний для судей и замена наместников выборным самоуправлением", badge: "XVI век")

#grid(
  columns: (1.2fr, 1.2fr),
  gutter: 18pt,
  [
    #card-box("Судебник 1550 г.: статьи 3–5", [
      - *Бояре и судьи (ст. 3):* возмещение иска, царские пошлины втрое, «а в посуле что государь укажет».
      - *Дьяки (ст. 4):* иск и пошлины втрое, *торговая казнь* кнутом и тюрьма.
      - *Подьячие (ст. 5):* битье кнутом на торгу и пожизненная дисквалификация.
    ], color: "#b91c1c")
    
    #v(0.2cm)
    #rect(width: 100%, fill: rgb("#fffbeb"), stroke: 1pt + rgb("#fde68a"), inset: 8pt, radius: 4pt)[
      *Казус 1556 г.:* казнь дьяка за «фаршированного монетами гуся» (отрублены ноги и руки на площади).
    ]
  ],
  [
    #card-box("Отмена кормлений (1555–1556 гг.)", [
      *«Приговор царский о кормлениях»:*
      1. Наместники и волостели упразднены.
      2. Введен налог в казну — *«кормленый окуп»*.
      3. Уголовный суд передан выборным дворянским *губным старостам*.
      4. Гражданский суд и налоги переданы выборным *земским старостам*.
    ], color: "#15803d")
    
    #v(0.2cm)
    #text(size: 10.5pt, fill: rgb("#475569"))[
