#set document(title: [Возникновение и история коррупции на Древней Руси], author: "Академический семинар")

// Настройка страницы для слайдов формата 16:9
#set page(
  paper: "presentation-16-9",
  margin: (x: 2.2cm, top: 1.8cm, bottom: 1.5cm),
  fill: rgb("#fcfbf9"),
  header: context {
    let page-num = counter(page).get().first()
    if page-num > 1 {
      grid(
        columns: (1fr, auto),
        align: (left + horizon, right + horizon),
        text(size: 11pt, fill: rgb("#6b7280"), font: "Liberation Sans", weight: "medium")[
          История коррупции на Древней Руси: историко-правовой анализ
        ],
        text(size: 11pt, fill: rgb("#9ca3af"), font: "Liberation Sans")[
          #page-num / 10
        ]
      )
      v(-4pt)
      line(length: 100%, stroke: 0.5pt + rgb("#e5e7eb"))
    }
  },
  footer: context {
    let page-num = counter(page).get().first()
    if page-num > 1 {
      line(length: 100%, stroke: 0.5pt + rgb("#e5e7eb"))
      v(-2pt)
      grid(
        columns: (1fr, auto),
        align: (left + horizon, right + horizon),
        text(size: 9.5pt, fill: rgb("#9ca3af"), font: "Liberation Sans")[
          Академический семинар по истории государства и права
        ],
        text(size: 9.5pt, fill: rgb("#8b1e1e"), font: "Liberation Sans", weight: "bold")[
          XI–XVII вв.
        ]
      )
    }
  }
)

#set text(
  font: ("Liberation Sans", "Noto Sans", "Liberation Serif"),
  size: 14pt,
  lang: "ru"
)

#set par(justify: true, leading: 0.65em)

// Кастомные стили блоков
#let slide-title(title, subtitle: none) = {
  v(0.2cm)
  text(size: 24pt, weight: "bold", fill: rgb("#1e293b"), font: "Liberation Sans")[#title]
  if subtitle != none {
    v(-0.3cm)
    text(size: 14pt, weight: "medium", fill: rgb("#8b1e1e"), font: "Liberation Sans")[#subtitle]
  }
  v(0.4cm)
}

#let quote-box(body, source: none, greek: false) = {
  rect(
    width: 100%,
    fill: rgb("#f3f4f6"),
    stroke: (left: 4pt + rgb("#8b1e1e"), rest: none),
    inset: (x: 14pt, y: 11pt),
    radius: (right: 4pt)
  )[
    #text(
      size: if greek { 12pt } else { 13pt },
      style: "italic",
      fill: rgb("#1f2937"),
      font: if greek { "Liberation Serif" } else { "Liberation Sans" }
    )[#body]
    #if source != none {
      v(4pt)
      align(right)[
        #text(size: 11pt, weight: "bold", fill: rgb("#4b5563"))[— #source]
      ]
    }
  ]
}

#let card-box(title, body, color: "#1e3a8a") = {
  rect(
    width: 100%,
    fill: rgb("#ffffff"),
    stroke: 1pt + rgb("#e2e8f0"),
    inset: 12pt,
    radius: 6pt
  )[
    #text(weight: "bold", size: 14pt, fill: rgb(color))[#title]
    #v(4pt)
    #text(size: 12pt, fill: rgb("#334155"))[#body]
  ]
}

