#set document(title: [Возникновение и история коррупции на Древней Руси], author: "Академический семинар")

// Настройка страницы для слайдов формата 16:9 без футера
#set page(
  paper: "presentation-16-9",
  margin: (x: 2.2cm, top: 1.6cm, bottom: 1.2cm),
  fill: rgb("#fcfbf9"),
  header: context {
    let page-num = counter(page).get().first()
    if page-num > 1 {
      grid(
        columns: (1fr, auto),
        align: (left + horizon, right + horizon),
        text(size: 11pt, fill: rgb("#6b7280"), font: "Liberation Sans", weight: "medium")[
          История коррупции на Древней Руси: историко-правовой анализ
        ],
        text(size: 11pt, fill: rgb("#9ca3af"), font: "Liberation Sans")[
          #page-num / 11
        ]
      )
      v(-4pt)
      line(length: 100%, stroke: 0.5pt + rgb("#e5e7eb"))
    }
  },
  footer: none
)

#set text(
  font: ("Liberation Sans", "Noto Sans", "Liberation Serif"),
  size: 13.5pt,
  lang: "ru"
)

#set par(justify: true, leading: 0.65em)

// Кастомные стили блоков
#let century-badge(century) = {
  box(
    fill: rgb("#8b1e1e"),
    inset: (x: 7pt, y: 3pt),
    radius: 3pt,
    baseline: 0%
  )[
    #text(size: 13pt, weight: "bold", fill: white)[#century]
  ]
}

#let slide-title(title, subtitle: none, badge: none) = {
  v(0.1cm)
  grid(
    columns: if badge != none { (auto, 1fr) } else { (1fr,) },
    gutter: 10pt,
    align: horizon,
    if badge != none { century-badge(badge) },
    text(size: 22pt, weight: "bold", fill: rgb("#1e293b"), font: "Liberation Sans")[#title]
  )
  if subtitle != none {
    v(-0.25cm)
    text(size: 13.5pt, weight: "medium", fill: rgb("#8b1e1e"), font: "Liberation Sans")[#subtitle]
  }
  v(0.35cm)
}

#let quote-box(body, source: none, greek: false) = {
  rect(
    width: 100%,
    fill: rgb("#f3f4f6"),
    stroke: (left: 4pt + rgb("#8b1e1e"), rest: none),
    inset: (x: 13pt, y: 10pt),
    radius: (right: 4pt)
  )[
    #text(
      size: if greek { 11.5pt } else { 12.5pt },
      style: "italic",
      fill: rgb("#1f2937"),
      font: if greek { "Liberation Serif" } else { "Liberation Sans" }
    )[#body]
    #if source != none {
      v(3pt)
      align(right)[
        #text(size: 10.5pt, weight: "bold", fill: rgb("#4b5563"))[— #source]
      ]
    }
  ]
}

#let card-box(title, body, color: "#1e3a8a") = {
  rect(
    width: 100%,
    fill: rgb("#ffffff"),
    stroke: 1pt + rgb("#e2e8f0"),
    inset: 11pt,
    radius: 6pt
  )[
    #text(weight: "bold", size: 13.5pt, fill: rgb(color))[#title]
    #v(3pt)
    #text(size: 11.5pt, fill: rgb("#334155"))[#body]
  ]
}

// -----------------------------------------------------------------------------
// СЛАЙД 1. ТИТУЛЬНЫЙ
// -----------------------------------------------------------------------------
#place(top + left)[
  #v(1.8cm)
  #rect(fill: rgb("#8b1e1e"), width: 3.5cm, height: 4pt, radius: 2pt)[]
  #v(0.4cm)
  #text(size: 28pt, weight: "bold", fill: rgb("#0f172a"), font: "Liberation Sans")[
    Возникновение и история\ коррупции на Древней Руси
  ]
  #v(0.2cm)
  #text(size: 17pt, weight: "medium", fill: rgb("#8b1e1e"), font: "Liberation Sans")[
    Хронологический историко-правовой анализ: X–XVII века
  ]
  
  #v(1.4cm)
  #line(length: 100%, stroke: 0.8pt + rgb("#cbd5e1"))
  #v(0.4cm)
  
  #grid(
    columns: (2fr, 1.2fr),
    gutter: 2cm,
    [
      #text(size: 12.5pt, fill: rgb("#475569"))[
        *Предмет:* эволюция от дарообмена и кормлений к криминализации посула\
        *Источники:* Византийская прония, Ордынское баскачество, собор 1274 г., Судебники
      ]
    ],
    [
      #align(right)[
        #text(size: 13pt, weight: "bold", fill: rgb("#1e293b"))[Академический семинар]\
        #text(size: 12pt, fill: rgb("#64748b"))[Хронометраж: 10 минут]
      ]
    ]
  )
]

#pagebreak()

// -----------------------------------------------------------------------------
// СЛАЙД 2. ТЕРМИНОЛОГИЧЕСКИЙ ЛАБИРИНТ
// -----------------------------------------------------------------------------
#slide-title("Понятийный аппарат древнерусского права", subtitle: "Пять категорий: от ритуального дара уважения к корыстному преступлению")

#grid(
  columns: (1fr, 1fr, 1fr),
  gutter: 12pt,
  card-box("1. Почесть (дар)", [
    *Архаический обычай:*
    - Добровольный дар уважения князю или судье до/после суда.
    - Опирается на традицию потлача: *«дар требует отдарка»* (М. Мосс).
    - Являлась социально одобряемой нормой чести.
  ], color: "#15803d"),
  card-box("2. Корм (содержание)", [
    *Законный институт:*
    - Материальное обеспечение наместников за счет тяглого населения.
    - Формы: *въездной*, *рождественский*, *петровский* кормы.
    - Взимание судебных пошлин (*виры*, *продажи*, *попятное*).
  ], color: "#0369a1"),
  card-box("3. Посул (взятка)", [
    *Корыстная сделка:*
    - От слова *«посулить»* (пообещать).
    - Тайная плата судье за конкретное выгодное процессуальное решение.
    - Первый прямо криминализованный состав на Руси (с 1397 г.).
  ], color: "#b91c1c")
)

#v(0.4cm)
#rect(width: 100%, fill: rgb("#fef2f2"), stroke: 1pt + rgb("#fecaca"), inset: 10pt, radius: 6pt)[
  #grid(
    columns: (1.1fr, 1.5fr),
    gutter: 14pt,
    [
      #text(weight: "bold", size: 12.5pt, fill: rgb("#991b1b"))[Мздоимство]\
      #text(size: 11.5pt, fill: rgb("#450a0a"))[Плата чиновнику за ускорение или совершение *законных действий* по службе. Долгое время не наказывалось.]
    ],
    [
      #text(weight: "bold", size: 12.5pt, fill: rgb("#991b1b"))[Лихоимство]\
      #text(size: 11.5pt, fill: rgb("#450a0a"))[Вымогательство сборов *«сверх меры»* (*лихва*) либо плата за *заведомо неправосудный вердикт*. Безусловно каралось.]
    ]
  )
]

#pagebreak()

// -----------------------------------------------------------------------------
// СЛАЙД 3. X ВЕК: АРХАИЧЕСКИЕ ИСТОКИ
// -----------------------------------------------------------------------------
#slide-title("Архаические истоки: Полюдье и реформа Ольги", subtitle: "Первый конфликт о пределах изъятия прибавочного продукта и фиксация норм", badge: "X век")

#grid(
  columns: (1.3fr, 1.1fr),
  gutter: 18pt,
  [
    #quote-box([
      «Слышавше же древляне, яко опять идет, сдумавше древляне с князем своим Малом: *“Аще ся ввадит волк в овце, то выносит все стадо, аще не убьють его; тако и се: аще не убьем его, то вся ны погубит”*... И убиша Игоря и дружину его...»
    ], source: [Повесть временных лет, под 945 годом])
    
    #v(0.3cm)
    *Институциональный смысл прецедента 945 г.:*
    - *Полюдье* соединяло сбор дани, правосудие и кормление дружины.
    - Князь Игорь нарушил неписаный общественный договор, попытавшись собрать дань повторно (архаичное лихоимство).
  ],
  [
    #card-box("Реформа княгини Ольги (946–947 гг.)", [
      Первая фискально-правовая регламентация на Руси:
      
      - *«Уроки»* — строго нормированные размеры податей, пресекающие произвольный сбор.
      - *«Погосты»* — постоянные административно-судебные центры с княжескими тиунами.
      - Переход от бродячего изъятия к территориальному учету.
    ], color: "#8b1e1e")
  ]
)

#pagebreak()

// -----------------------------------------------------------------------------
// СЛАЙД 4. XI–XII ВЕКА: РУССКАЯ ПРАВДА И ВИЗАНТИЙСКАЯ ПРОНИЯ
// -----------------------------------------------------------------------------
#slide-title("«Покон вирный» и византийская Прония", subtitle: "Правовая регламентация кормления на Руси и приватизация фиска в Византии", badge: "XI–XII вв.")

#grid(
  columns: (1.1fr, 1.3fr),
  gutter: 18pt,
  [
    #card-box("Русская Правда: «Покон вирный» (ст. 9)", [
      *Законная таксация содержания вирника:*
      - 8 гривен кунами со следа убийства;
      - хлеба — сколко смогуть съясти;
      - солоду на неделю 7 ведер;
      - овса 7 уборков, мяса туша или полоть;
      - 4 коням корм.
      *Светское право еще не знает запрета посулов!*
    ], color: "#0369a1")
  ],
  [
    #card-box("Византия: институт Пронии (ἡ πρόνοια)", [
      - *Сущность:* раздача прав сбора налогов с крестьян (*париков*) воинам (*прониарам*) в обмен на службу.
      - *Экскуссия (ἐξκουσκεία):* судебный иммунитет от центра.
      - *Свидетельство Никиты Хониата:*
        #text(style: "italic", size: 10.5pt)[
          «...τὰς τῶν Ῥωμαίων ἐπαρχίας ταῖς τῶν στρατιωτῶν διένειμε χερσίν... Воины, обращая налоги в личную корысть, грабили бедняков до нитки, уподобившись разбойникам...»
        ]
    ], color: "#1e3a8a")
  ]
)

#pagebreak()

// -----------------------------------------------------------------------------
// СЛАЙД 5. XIII ВЕК (ОРДА): БАСКАЧЕСТВО И ОТКУПЫ
// -----------------------------------------------------------------------------
#slide-title("Ордынский фактор: Баскачество и откупы", subtitle: "Тотальный фискальный учет, хищнический откуп и институционализация произвола", badge: "XIII век")

#grid(
  columns: (1.2fr, 1.2fr),
  gutter: 18pt,
  [
    #card-box("Перепись 1257 г. и «бесермене»", [
      - *«Численники» (1257 г.):* перепись Суздальской, Рязанской, Муромской земель; деление на десятки, сотни, тьмы.
      - *Баскаки (даругачи):* военные наместники хана для надзора за князьями и сбора «выхода».
      - *Откупщики-бесермене:* откуп дани мусульманскими купцами с ростовщической лихвой; восстания 1262 г. в Ростове, Владимире и Суздале.
    ], color: "#b45309")
  ],
  [
    #quote-box([
      «Бысть тогда баскак велик именем Ахмат... волости держаше Курские... И сотвори две слободы в отчине князя... сведе тамо множество разбойников, и сотвори себе державу велию, и пошлины тяжки наложи на землю...»
    ], source: [Повесть о баскаке Ахмате, конец XIII в.])
    
    #v(0.2cm)
    #text(size: 11pt, fill: rgb("#475569"))[
      *Ханские ярлыки:* прямо запрещали баскакам брать «почести» с церкви под угрозой смерти — свидетельство их системности.
    ]
  ]
)

#pagebreak()

// -----------------------------------------------------------------------------
// СЛАЙД 6. XIII ВЕК (ЦЕРКОВЬ): ВЛАДИМИРСКИЙ СОБОР 1274 Г.
// -----------------------------------------------------------------------------
#slide-title("Канонический поворот: собор 1274 года", subtitle: "Рецепция библейской формулы Втор. 16:19 и первое обличение судебной взятки на Руси", badge: "XIII век")

#grid(
  columns: (1.3fr, 1.1fr),
  gutter: 18pt,
  [
    #quote-box([
      «Судии же да судят в правду, а *мзды от суда не емлют*, понеже *мзда ослепляет очи мудрых и развращает словеса праведных* [Втор. 16:19; Исх. 23:8]. Аще ли кто по мзде судит или по посулу, таковый пред Богом разбойник есть, и сан его да отнимется, и от церкви да отлучится...»
    ], source: [Правила Владимирского собора 1274 г. Митрополит Кирилл II])
    
    #v(0.3cm)
    #card-box("Серапион Владимирский (1270-е гг.)", [
      *«Слово о казнях Божиих»:*
      #text(style: "italic", size: 11pt)[
        «...Лихву емлем, сироты обидим, судии посулы емлют, от праведнаго неправедна творят... Сего ради попусти на ны Бог язычников...»
      ]
    ], color: "#8b1e1e")
  ],
  [
    #card-box("Институциональное значение собора 1274 г.", [
      1. *Церковь как первый законодатель против коррупции:* светские законы молчали о посулах; именно каноническое право впервые назвало взятку преступлением.
      2. *Рецепция через Кормчую книгу:* византийские правовые сборники принесли на Русь прямой библейский запрет мзды судьям.
      3. *Нравственная дифференциация:* четкое отделение праведного суда от грабежа под видом традиционной «почести».
    ], color: "#15803d")
  ]
)

#pagebreak()

// -----------------------------------------------------------------------------
// СЛАЙД 7. XIV ВЕК: ВОЗВЫШЕНИЕ МОСКВЫ И ГРАМОТА 1397 Г.
// -----------------------------------------------------------------------------
#slide-title("Калита и Двинская уставная грамота", subtitle: "Концентрация сбора дани в Москве и первый светский законодательный запрет посула", badge: "XIV век")

#grid(
  columns: (1.2fr, 1.2fr),
  gutter: 18pt,
  [
    #card-box("Иван I Калита (с 1328 г.)", [
      *Переход фискальных функций от Орды:*
      - После Тверского восстания 1327 г. хан Узбек передал сбор ордынского выхода великому князю Владимирскому/Московскому.
      - Москва переняла ордынские методы жесткого учета и круговой поруки.
      - Разница между сбором и доставкой в Сарай оседала в казне («калите»), став базой централизации.
    ], color: "#b45309")
  ],
  [
    #card-box("Двинская уставная грамота 1397 г.", [
      *Статья 6 — исторический прецедент:*
      #text(style: "italic", fill: rgb("#8b1e1e"))[
        «А наместници двинстии и их тиуни судят... а посула не емлют ни от суда, ни от печалования, ни их отроци... А кто возмет посул, и уличат его, и он виноват князю великому...»
      ]
      
      #v(6pt)
      *Первый в светском праве запрет посула:*
      Спустя 123 года после собора 1274 г. запрет взятки впервые вошел в великокняжеский закон!
    ], color: "#0369a1")
  ]
)

#pagebreak()

// -----------------------------------------------------------------------------
// СЛАЙД 8. XV ВЕК: БЕЛОЗЕРСКАЯ ТАКСАЦИЯ И СУДЕБНИК 1497 Г.
// -----------------------------------------------------------------------------
#slide-title("Белозерская грамота и Судебник 1497 года", subtitle: "Таксация натуральных кормов, запрет посула судьям и парадокс Герберштейна", badge: "XV век")

#grid(
  columns: (1.2fr, 1.2fr),
  gutter: 18pt,
  [
    #card-box("Белозерская грамота 1488 г.", [
      *Строгая таксация кормов наместников:*
      - Со 100 сох: ровно 150 хлебов, 40 баранов, 10 бочек пива к Рождеству.
      - Фиксация пошлин за суд и явку.
      - Запрет самовольных поборов: *«А кто возьмет лишнее — платити ему втрое»*.
    ], color: "#0369a1")
    
    #v(0.2cm)
    #card-box("Судебник 1497 г. (ст. 1)", [
      *«А посулов бояром, и околничим, и диаком от суда... не имати никому...»*\
      *Коллизия:* запрет есть, но санкция против бояр отсутствует!
    ], color: "#1e3a8a")
  ],
  [
    #quote-box([
      «Судья был обвинен в том, что, взяв взятку с обеих сторон, решил в пользу давшего больше. Судья признался перед государем: богатый почтеннее, посему ему подобает верить паче, к тому же он дал больше. Государь лишь посмеялся и отпустил его...
      
      Причиною корыстолюбия судей является бедность, и государь закрывает глаза на их проступки...»
    ], source: [Сигизмунд Герберштейн. Записки о Московии])
  ]
)

#pagebreak()

