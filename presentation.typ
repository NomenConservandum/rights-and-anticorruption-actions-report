#set document(title: [Возникновение и история коррупции на Древней Руси], author: "Храмов Александр")

// Настройка страницы 16:9 для академической презентации
#set page(
  paper: "presentation-16-9",
  margin: (x: 2cm, top: 1.5cm, bottom: 1.2cm),
  fill: rgb("#fcfbf9"),
  header: context {
    let p = counter(page).get().first()
    if p > 1 {
      grid(
        columns: (1fr, auto),
        align: (left + horizon, right + horizon),
        text(size: 10.5pt, fill: rgb("#64748b"), font: "Liberation Sans", weight: "medium")[
          Возникновение и история коррупции на Древней Руси
        ],
        text(size: 10.5pt, fill: rgb("#94a3b8"), font: "Liberation Sans", weight: "bold")[
          #p / 10
        ]
      )
      v(-4pt)
      line(length: 100%, stroke: 0.5pt + rgb("#e2e8f0"))
    }
  },
  footer: none
)

#set text(
  font: ("Liberation Sans", "Noto Sans"),
  size: 13pt,
  fill: rgb("#1e293b"),
  lang: "ru"
)

#set par(justify: false, leading: 0.6em)

// Функции стилизации элементов
#let century-tag(text-content) = {
  box(
    fill: rgb("#8b1e1e"),
    inset: (x: 8pt, y: 3.5pt),
    radius: 3pt
  )[
    #text(size: 11pt, weight: "bold", fill: white)[#text-content]
  ]
}

#let slide-header(title, subtitle: none, badge: none) = {
  v(0.1cm)
  grid(
    columns: if badge != none { (auto, 1fr) } else { (1fr,) },
    gutter: 10pt,
    align: horizon,
    if badge != none { century-tag(badge) },
    text(size: 21pt, weight: "bold", fill: rgb("#0f172a"))[#title]
  )
  if subtitle != none {
    v(-0.25cm)
    text(size: 12.5pt, weight: "medium", fill: rgb("#8b1e1e"))[#subtitle]
  }
  v(0.35cm)
}

#let card(title: none, body: none, accent: false, fill-color: none) = {
  let bg = if fill-color != none { fill-color } else if accent { rgb("#fef2f2") } else { rgb("#ffffff") }
  let border = if accent { 1pt + rgb("#f87171") } else { 1pt + rgb("#e2e8f0") }
  rect(
    width: 100%,
    fill: bg,
    stroke: border,
    radius: 5pt,
    inset: (x: 14pt, y: 12pt)
  )[
    #if title != none {
      text(weight: "bold", size: 13.5pt, fill: if accent { rgb("#991b1b") } else { rgb("#0f172a") })[#title]
      v(4pt)
    }
    #text(size: 12pt, fill: rgb("#334155"))[#body]
  ]
}

#let quote-callout(text-body, source: none) = {
  rect(
    width: 100%,
    fill: rgb("#f8fafc"),
    stroke: (left: 3.5pt + rgb("#8b1e1e"), rest: 0.5pt + rgb("#e2e8f0")),
    radius: (right: 4pt),
    inset: (x: 14pt, y: 10pt)
  )[
    #text(style: "italic", size: 12.5pt, fill: rgb("#1e293b"))[«#text-body»]
    #if source != none {
      v(3pt)
      align(right)[#text(size: 10.5pt, weight: "medium", fill: rgb("#64748b"))[— #source]]
    }
  ]
}

// -------------------------------------------------------------
// СЛАЙД 1: Титульный
// -------------------------------------------------------------
#align(center + horizon)[
  #box(
    fill: rgb("#8b1e1e"),
    inset: (x: 12pt, y: 5pt),
    radius: 4pt
  )[
    #text(size: 12pt, weight: "bold", fill: white)[ИСТОРИКО-ПРАВОВОЙ АНАЛИЗ]
  ]
  #v(0.4cm)
  #text(size: 27pt, weight: "bold", fill: rgb("#0f172a"))[
    Возникновение и история коррупции\ на Древней Руси
  ]
  #v(0.2cm)
  #text(size: 15pt, fill: rgb("#64748b"))[
    Институциональный генезис, понятийный аппарат и эволюция запретов
  ]
  #v(0.8cm)
  #line(length: 40%, stroke: 1pt + rgb("#8b1e1e"))
  #v(0.5cm)
  #grid(
    columns: (auto,),
    gutter: 4pt,
    text(size: 13.5pt, weight: "bold", fill: rgb("#1e293b"))[Храмов Александр],
    text(size: 12pt, fill: rgb("#64748b"))[Студент 451 группы • Академический семинар]
  )
]

#pagebreak()

// -------------------------------------------------------------
// СЛАЙД 2: Понятийный компас
// -------------------------------------------------------------
#slide-header(
  "Понятийный компас Древней Руси",
  subtitle: "Почему нормы современного УК РФ неприменимы к средневековым институтам"
)

#grid(
  columns: (1fr, 1fr),
  gutter: 14pt,
  card(
    title: "1. Почесть (Легальный дар)",
    body: [
      Социально одобряемый, открытый дар князю или судье до или после тяжбы. \
      *Суть:* знак признания высокого статуса властителя. Не являлась условием вынесения решения в пользу дарителя.
    ]
  ),
  card(
    title: "2. Лихоимство (Превышение меры)",
    accent: true,
    body: [
      Взимание поборов сверх установленного обычаем или законом предела. \
      *Суть:* корыстное злоупотребление положением («взятие лишнего»), нарушающее баланс неписаной нормы.
    ]
  ),
  card(
    title: "3. Посул (Взятка-подкуп)",
    accent: true,
    body: [
      Тайная мзда должностному лицу за совершение конкретного выгодного действия либо за волокиту дела. \
      *Суть:* впервые криминализируется в светском праве лишь в конце XIV века.
    ]
  ),
  card(
    title: "4. Мзда (Плата за обязанность)",
    body: [
      Изначально нейтральное слово («плата, воздаяние»), ставшее синонимом незаконного побора за исполнение прямых обязанностей чиновника.
    ]
  )
)

#pagebreak()

// -------------------------------------------------------------
// СЛАЙД 3: IX–XI вв. Полюдье и первый прецедент
// -------------------------------------------------------------
#slide-header(
  "IX–XI вв. Полюдье и прецедент 945 года",
  subtitle: "Рождение института содержания власти и первый кризис лихоимства",
  badge: "IX–XI вв."
)

#grid(
  columns: (1.1fr, 0.9fr),
  gutter: 16pt,
  [
    #card(
      title: "Институт полюдья: баланс обмена",
      body: [
        - *Экономический контекст:* безмонетный период, отсутствие чиновничьего аппарата и регулярных налогов.
        - *Механика:* князь с дружиной с ноября по апрель лично объезжает подвластные племена.
        - *Неписаный общественный договор:* население дает содержание («корм» и дары) — князь обеспечивает военную защиту и суд.
      ]
    )
    #v(8pt)
    #card(
      title: "Реформа княгини Ольги (946 г.)",
      fill-color: rgb("#f1f5f9"),
      body: [
        Впервые в истории Руси произведена фиксация налоговых изъятий:
        - *Уроки* — точные размеры дани;
        - *Погосты* — постоянные пункты сбора.
      ]
    )
  ],
  [
    #card(
      title: "Прецедент князя Игоря (945 г.)",
      accent: true,
      body: [
        - Повторный сбор дани с древлян за один сезон («пошел еще к ним, желая большего богатства»).
        - С точки зрения древлян, Игорь нарушил традицию и перестал быть законным государем.
        - *Итог:* восстание и казнь князя.
      ]
    )
    #v(8pt)
    #quote-callout(
      "Если повадится волк к овцам, то унесет все стадо, пока не убьют его; так и этот: если не убьем его, то всех нас погубит.",
      source: "Повесть временных лет, 945 г."
    )
  ]
)

#pagebreak()

// -------------------------------------------------------------
// СЛАЙД 4: Византийский след
// -------------------------------------------------------------
#slide-header(
  "Византийский след: Кормчая книга и миф о пронии",
  subtitle: "Церковно-правовые нормы против мздоимства и научная критика заимствования",
  badge: "Каноны"
)

#grid(
  columns: (1fr, 1fr),
  gutter: 16pt,
  card(
    title: "Кормчая книга (Номоканон)",
    body: [
      - Вместе с крещением Руси приходит византийское церковное право.
      - В отличие от архаичной светской Правды, Кормчая книга содержала *прямые этические запреты* на взяточничество и подкуп судей.
      - Церковь первой на Руси стала рассматривать мздоимство как грех и разрушение справедливости.
      - *Владимирский собор 1274 г.:* митрополит Кирилл II прямо запрещает судебную мзду.
    ]
  ),
  card(
    title: "Развенчание мифа о пронии (πρόνοια)",
    accent: true,
    body: [
      - *Распространенный миф:* система русских кормлений якобы скопирована из Византии в IX веке.
      - *Исторический факт:* военная прония возникла в Византии лишь в конце XI в. при Алексее I Комнине.
      - Законодательные тексты Кормчей восходят к VIII–IX вв. и не содержат институтов пронии.
      - *Вывод:* русское кормление — автохтонный институт содержания дружины, развившийся самостоятельно.
    ]
  )
)

#v(10pt)
#quote-callout(
  "Мзда ослепляет очи мудрых и развращает слова праведных.",
  source: "Правила Владимирского собора 1274 г. (Втор. 16:19)"
)

#pagebreak()

// -------------------------------------------------------------
// СЛАЙД 5: XII–XIII вв. Институт кормлений
// -------------------------------------------------------------
#slide-header(
  "XII–XIII вв. Кормление как государственная система",
  subtitle: "Структурные стимулы к злоупотреблениям и поборы судебно-административного аппарата",
  badge: "XII–XIII вв."
)

#grid(
  columns: (1fr, 1fr, 1fr),
  gutter: 12pt,
  card(
    title: "Срок: 1–2 года",
    accent: true,
    body: [
      Бояре получали волости временно. Главный мотив — окупить затраты на оружие и коней, обеспечить род и накопить на службу. Возникала логика максимальной выжимки волости в сжатые сроки.
    ]
  ),
  card(
    title: "Въезд и суд",
    body: [
      Кроме планового продовольствия («корма»), наместник взимал:
      - *Въезжий корм* (дары при вступлении);
      - *Судебные пошлины* («суд и пересуд»);
      - Натуральные подати по обычаю («по старине»).
    ]
  ),
  card(
    title: "Тиуны и доводчики",
    accent: true,
    body: [
      Аппарат наместника не получал жалования и кормился с пошлин:
      - Брали плату *поверстно* за каждую версту вручения повестки;
      - Практиковали шантаж поддельными вызовами в суд для вымогательства.
    ]
  )
)

#v(12pt)
#quote-callout(
  "Кормление — это не служба для области, а область для службы.",
  source: "В.О. Ключевский, Курс русской истории"
)

#pagebreak()

// -------------------------------------------------------------
// СЛАЙД 6: XIII–XIV вв. Ордынское иго
// -------------------------------------------------------------
#slide-header(
  "XIII–XIV вв. Ордынский след: откупщики и «поминки»",
  subtitle: "Институализация внешней ренты и противостояние незаконным поборам",
  badge: "XIII–XIV вв."
)

#grid(
  columns: (1.1fr, 0.9fr),
  gutter: 16pt,
  [
    #card(
      title: "Откуп дани бесерменами",
      body: [
        - Хан передавал сбор «выхода» мусульманским купцам-откупщикам (*бесерменам*).
        - Откупщики вносили хану фиксированную сумму, а всю сверхприбыль выжимали из населения.
        - *Итог:* в 1262 г. восстания во Владимире, Ростове, Ярославле и Суздале полностью смели систему откупов.
      ]
    )
    #v(8pt)
    #card(
      title: "Система «поминок» в Сарае",
      accent: true,
      body: [
        Поездки за ханским ярлыком превратились в институциональный торг: князья везли колоссальные взятки хану, ханшам и сановникам («поминки»).
      ]
    )
  ],
  [
    #card(
      title: "Новгородская альтернатива",
      fill-color: rgb("#f1f5f9"),
      body: [
        Новгородская республика ограничивала княжескую власть договорами:
        - Запрет князю судить без новгородского посадника;
        - Запрет скупать земли и волости в Новгородской земле;
        - Изгнание князей за нарушение крестного целования.
      ]
    )
  ]
)

#pagebreak()

// -------------------------------------------------------------
// СЛАЙД 7: Иван Калита и возвышение Москвы
// -------------------------------------------------------------
#slide-header(
  "1328 год: Финансовый маневр Ивана Калиты",
  subtitle: "Устранение баскаков и концентрация ордынского «выхода» в руках Москвы",
  badge: "1328 г."
)

#grid(
  columns: (1fr, 1fr),
  gutter: 16pt,
  card(
    title: "Перехват фискальной монополии",
    body: [
      - В 1328 г. после подавления Тверского восстания Иван Калита получает ярлык и *право сбора дани со всех русских земель*.
      - Институт ордынских военных наместников (*баскаков*) на Руси фактически ликвидирован.
      - Потоки серебра стали стекаться напрямую в казну московского князя.
    ]
  ),
  card(
    title: "Непрозрачность и капитализация",
    accent: true,
    body: [
      - Точный объем сборов знал только сам Калита: образующаяся разница между сбором и ордынской выплатой оседала в Москве.
      - *Результаты финансовой концентрации:*
        1. Скупка сел, волостей и ярлыков у обедневших князей («купли Калиты»);
        2. Строительство дубового (а позже белокаменного) Кремля;
        3. Закрепление за Москвой роли политического центра Руси.
    ]
  )
)

#v(10pt)
#quote-callout(
  "Контроль над финансовыми потоками ордынской дани стал фундаментом московского единодержавия.",
  source: "А.А. Горский, «Москва и Орда»"
)

#pagebreak()

// -------------------------------------------------------------
// СЛАЙД 8: XIV–XV вв. Первые светские запреты
// -------------------------------------------------------------
#slide-header(
  "XIV–XV вв. Двинская грамота и парадокс 1497 года",
  subtitle: "Появление светской уголовной нормы и феномен «запрета без наказания»",
  badge: "XIV–XV вв."
)

#grid(
  columns: (1fr, 1fr),
  gutter: 16pt,
  card(
    title: "1397 г. Двинская уставная грамота",
    body: [
      - Первый в истории светский законодательный акт, прямо запретивший судебный посул: \
        *«А наместники и их тиуны посулов в суде не емлют»*.
      - Примерно тогда же Псковская судная грамота вводит присягу судей на кресте не брать взяток.
    ]
  ),
  card(
    title: "1497 г. Судебник Ивана III: парадокс ст. 1",
    accent: true,
    body: [
      - *Статья 1:* категорический запрет боярам и судьям брать посулы за разбирательство дел.
      - *Парадокс законодателя:* в кодексе *не предусмотрено никаких санкций* за нарушение статьи!
      - При доказанной взятке судебное решение просто отменялось, судья оставался безнаказанным.
    ]
  )
)

#v(10pt)
#quote-callout(
  "Хотя судьям запрещено принимать подарки, однако если кто не помажет колеса, повозка его не поедет...",
  source: "Сигизмунд Герберштейн, «Записки о Московии» (нач. XVI в.)"
)

#pagebreak()

// -------------------------------------------------------------
// СЛАЙД 9: XVI в. Судебник 1550 г. и конец кормлений
// -------------------------------------------------------------
#slide-header(
  "XVI в. Реформы Ивана Грозного",
  subtitle: "Реальная уголовная дифференциация и ликвидация системы кормлений",
  badge: "XVI в."
)

#grid(
  columns: (1.1fr, 0.9fr),
  gutter: 16pt,
  [
    #card(
      title: "Судебник 1550 года (ст. 3–5): Санкции",
      accent: true,
      body: [
        Впервые установлена строгая лестница уголовной ответственности:
        - *Бояре и судьи:* лишение сана, тройной штраф суммы иска и судебных пошлин;
        - *Дьяки:* тюремное заключение и возмещение ущерба;
        - *Подьячие (клерки):* *торговая казнь* — публичное битье кнутом на площади («бити кнутом на торгу»).
      ]
    )
  ],
  [
    #card(
      title: "1555–1556 гг. Ликвидация кормлений",
      body: [
        - Земская и Губная реформы: отмена института наместников-кормленщиков.
        - Власть на местах и суд по уголовным делам переданы *выборным от населения*:
          - Земским старостам;
          - Губным старостам;
          - Целовальникам.
      ]
    )
  ]
)

#pagebreak()

// -------------------------------------------------------------
// СЛАЙД 10: Итоги и выводы
// -------------------------------------------------------------
#slide-header(
  "Итоги исследования: 4 главных вывода",
  subtitle: "Эволюция институтов власти и контроля в IX–XVI веках"
)

#grid(
  columns: (1fr, 1fr),
  gutter: 14pt,
  card(
    title: "1. Автохтонность институтов",
    body: [
      Кормление развилось из княжеского полюдья и содержания дружины народом. Заимствование византийской пронии опровергается хронологией источников.
    ]
  ),
  card(
    title: "2. Экономическая природа лихоимства",
    accent: true,
    body: [
      В условиях безмонетной экономики и отсутствия денежных окладов короткий срок наместничества (1–2 года) неизбежно вел к максимальному выжиманию волости.
    ]
  ),
  card(
    title: "3. Внешний фискальный фактор",
    body: [
      Ордынская система откупа дани и ярлыков строилась на мзде, а перехват сбора дани Иваном Калитой в 1328 г. создал финансовую основу лидерства Москвы.
    ]
  ),
  card(
    title: "4. Эволюция правового запрета",
    accent: true,
    body: [
      Путь от морального осуждения Церковью (1274 г.) и беззубого запрета без санкций (1497 г.) до уголовных наказаний и отмены кормлений занял более 250 лет.
    ]
  )
)

