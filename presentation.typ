#set document(title: [Возникновение и история коррупции на Древней Руси], author: "Храмов Александр")

// Настройка страницы 16:9 для академической презентации
#set page(
  paper: "presentation-16-9",
  margin: (x: 2cm, top: 1.5cm, bottom: 1.2cm),
  fill: rgb("#fcfbf9"),
  header: none,
  footer: context {
    let p = counter(page).get().first()
    let total = counter(page).final().first()
    if p > 1 and p < total {
      align(right)[
        #text(size: 10.5pt, fill: rgb("#94a3b8"), font: "Liberation Sans", weight: "medium")[
          #p / #total
        ]
      ]
    }
  }
)

#set text(
  font: ("Liberation Sans", "Noto Sans"),
  size: 13pt,
  fill: rgb("#1e293b"),
  lang: "ru"
)

#set par(justify: false, leading: 0.6em)

// Функции стилизации элементов
#let century-tag(text-content) = {
  box(
    fill: rgb("#8b1e1e"),
    inset: (x: 8pt, y: 3.5pt),
    radius: 3pt
  )[
    #text(size: 11pt, weight: "bold", fill: white)[#text-content]
  ]
}

#let slide-header(title, subtitle: none, badge: none) = {
  v(0.1cm)
  grid(
    columns: if badge != none { (auto, 1fr) } else { (1fr,) },
    gutter: 10pt,
    align: horizon,
    if badge != none { century-tag(badge) },
    text(size: 21pt, weight: "bold", fill: rgb("#0f172a"))[#title]
  )
  if subtitle != none {
    v(-0.25cm)
    text(size: 12.5pt, weight: "medium", fill: rgb("#8b1e1e"))[#subtitle]
  }
  v(0.35cm)
}

#let card(title: none, body: none, fill-color: none) = {
  let bg = if fill-color != none { fill-color } else { rgb("#ffffff") }
  rect(
    width: 100%,
    fill: bg,
    stroke: 1pt + rgb("#e2e8f0"),
    radius: 5pt,
    inset: (x: 14pt, y: 12pt)
  )[
    #if title != none {
      text(weight: "bold", size: 13.5pt, fill: rgb("#0f172a"))[#title]
      v(4pt)
    }
    #text(size: 12pt, fill: rgb("#334155"))[#body]
  ]
}

#let quote-callout(text-body, source: none) = {
  rect(
    width: 100%,
    fill: rgb("#f8fafc"),
    stroke: (left: 3.5pt + rgb("#8b1e1e"), rest: 0.5pt + rgb("#e2e8f0")),
    radius: (right: 4pt),
    inset: (x: 14pt, y: 10pt)
  )[
    #text(style: "italic", size: 12.5pt, fill: rgb("#1e293b"))["#text-body"]
    #if source != none {
      v(3pt)
      align(right)[#text(size: 10.5pt, weight: "medium", fill: rgb("#64748b"))[--- #source]]
    }
  ]
}

#let century-divider(century) = {
  page(footer: none)[
    #align(center + horizon)[
      #text(size: 44pt, weight: "bold", fill: rgb("#0f172a"))[#century]
    ]
  ]
}

#let image-slide(img-path) = {
  page(footer: none)[
    #align(center + horizon)[
      #image(img-path, height: 78%)
    ]
  ]
}

