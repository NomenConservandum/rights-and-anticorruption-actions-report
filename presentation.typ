// СЛАЙД 10: XII–XIII вв. Въезд и суд (кормы и пошлины)
// -------------------------------------------------------------
#slide-header(
  [XII–XIII вв. Въезд и суд: кормы и пошлины],
  subtitle: [Структура содержания наместника],
  badge: [XII–XIII вв.]
)

#grid(
  columns: (1fr, 1fr),
  gutter: 16pt,
  card(
    title: [Въезжий и срочный корм],
    body: [
      - Содержание наместника ("корм") полностью ложилось на народ;
      - *Въезжий корм:* обязательные подношения и дары при прибытии наместника в волость;
      - Нормы не были зафиксированы цифрой: всё определялось "по старине" и обычаю.
    ]
  ),
  card(
    title: [Судебные доходы],
    body: [
      - Плата за судебное разбирательство и пересмотр дел (*"суд и пересуд"*);
      - Отсутствие государственного надзора открывало простор для произвола и судебного вымогательства.
    ]
  )
)

#v(12pt)
#quote-callout(
  [Кормление --- это не служба для области, а область для службы.],
  source: [В.О. Ключевский, Курс русской истории]
)

